# Local-development defaults. Copy to .env and change before exposing anything
# beyond localhost:   cp .env.example .env

# Interface every published port binds to. Keep 127.0.0.1 unless you have changed
# the credentials below and know who can reach this machine.
BIND_ADDR=127.0.0.1

# --- RustFS (S3) ---
S3_ACCESS_KEY=pondhouse
S3_SECRET_KEY=pondhouse-secret-change-me
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000

# --- ClickHouse ---
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=pondhouse
CLICKHOUSE_DB=marts
# For SQLMesh running inside the Docker network, use: CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123

# --- Postgres (Dagster storage + demo CDC source) ---
POSTGRES_USER=pondhouse
POSTGRES_PASSWORD=pondhouse
POSTGRES_DB=pondhouse
# Host port for Postgres (change if it collides with another local stack)
POSTGRES_HOST_PORT=5433

# --- Sling ---
# UID:GID the Sling container runs as; must be able to write ingestion/sling.
# Set to the output of: echo "$(id -u):$(id -g)"
SLING_USER=1000:1000

# --- Beszel monitoring ---
# Paste the public key from Beszel UI (Settings -> Add System), then re-up the profile
BESZEL_AGENT_KEY=

# --- ETL schedule (5-field cron; Dagster and scheduler.py) ---
ETL_SCHEDULE_CRON=*/5 * * * *

# --- OpenMetadata (governance profile) ---
OM_VERSION=1.13.3
# Required for this profile. Generate with: openssl rand -base64 32
OM_FERNET_KEY=
OM_DB_PASSWORD=openmetadata_password
AIRFLOW_DB_PASSWORD=airflow_pass
AIRFLOW_ADMIN_PASSWORD=admin

# --- Kafka ---
# Generate with: uuidgen | tr '[:upper:]' '[:lower:]' | tr -d '-' | head -c 22
# KAFKA_CLUSTER_ID=
