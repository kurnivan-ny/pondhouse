<clickhouse>
    <!-- Named collection: RustFS (S3-compatible) lake storage.
         Credentials should match .env (S3_ACCESS_KEY, S3_SECRET_KEY).
         Note: ClickHouse XML config does not support ${ENV_VAR} substitution.
         For production, generate this file at runtime or use a secure secret store. -->
    <named_collections>
        <rustfs>
            <url>http://rustfs:9000/lake/</url>
            <access_key_id>pondhouse</access_key_id>
            <secret_access_key>pondhouse-secret-change-me</secret_access_key>
        </rustfs>
    </named_collections>
</clickhouse>
