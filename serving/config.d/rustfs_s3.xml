<clickhouse>
    <!-- Named collection: RustFS (S3-compatible) lake storage. Credentials come
         from the container environment, set from .env in docker-compose.yml. -->
    <named_collections>
        <rustfs>
            <url>http://rustfs:9000/lake/</url>
            <access_key_id from_env="S3_ACCESS_KEY"/>
            <secret_access_key from_env="S3_SECRET_KEY"/>
        </rustfs>
    </named_collections>
</clickhouse>
