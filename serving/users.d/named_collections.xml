<clickhouse>
    <!-- Lets the serving user use the `rustfs` named collection in table engines.
         Must match CLICKHOUSE_USER in .env. -->
    <users>
        <default>
            <named_collection_control>1</named_collection_control>
            <show_named_collections_secrets>1</show_named_collections_secrets>
        </default>
    </users>
</clickhouse>
